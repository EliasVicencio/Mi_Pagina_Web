{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mi-web",
  "compatibility_date": "2026-10-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [".git/**", "README.md", "wrangler.jsonc", ".wrangler/**"],
    "not_found_handling": "single-page-application"
  }
}
